{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm test && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/understat.mjs": {
      "maxDuration": 30
    },
    "api/ai.mjs": {
      "maxDuration": 300
    },
    "api/ai-status.mjs": {
      "maxDuration": 10
    },
    "api/teams.mjs": {
      "maxDuration": 30
    },
    "api/fantacalcio.mjs": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
